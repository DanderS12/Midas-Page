rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Storage permits only two distinct Firestore lookups: this policy plus the DM.
    function allowed() {
      return request.auth != null && (request.auth.token.email == 'david.d.rodriguez0804@gmail.com' ||
        (!firestore.exists(/databases/(default)/documents/accessPolicy/blocks) ||
          (!(request.auth.token.email.lower() in firestore.get(/databases/(default)/documents/accessPolicy/blocks).data.get('emails', []))
           && !(request.auth.token.get('signInIpAddress', 'unknown') in firestore.get(/databases/(default)/documents/accessPolicy/blocks).data.get('ips', [])))));
    }
    match /dm/{from}/{to}/{id} {
      // No reusable public download tokens: the app downloads through getBlob.
      allow get: if allowed() && (request.auth.uid == from || request.auth.uid == to)
        && firestore.get(/databases/(default)/documents/dms/$(id)).data.imagePath == 'dm/' + from + '/' + to + '/' + id
        && firestore.get(/databases/(default)/documents/dms/$(id)).data.from == from
        && firestore.get(/databases/(default)/documents/dms/$(id)).data.to == to;
      allow create: if allowed() && request.auth.uid == from && from != to
        && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg','image/png','image/gif','image/webp']
        && !request.resource.metadata.keys().hasAny(['firebaseStorageDownloadTokens']);
      allow delete: if allowed() && request.auth.uid == from;
    }
  }
}
