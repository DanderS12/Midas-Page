rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'david.d.rodriguez0804@gmail.com';
    }
    function hex(c) {
      return c is string && c.matches('^#[0-9a-fA-F]{6}$');
    }
    function okUser(d) {
      return d.keys().hasOnly(['uid','name','story','accent','bg','panel','text','border','btn','gc','pc','gs','ps','song','songTitle','ts'])
        && d.uid == request.auth.uid
        && d.name is string && d.name.size() <= 40
        && d.story is string && d.story.size() <= 4000
        && hex(d.accent) && hex(d.bg) && hex(d.panel) && hex(d.text)
        && hex(d.border) && hex(d.btn) && hex(d.gc) && hex(d.pc)
        && d.gs in ['sparkle','dots','stars','hearts','flowers','snow','none']
        && d.ps in ['paws','hearts','stars','flowers','snow','none']
        && d.song is string && d.song.size() <= 300
        && d.songTitle is string && d.songTitle.size() <= 60;
    }

    // Main site content: everyone reads, only the admin changes
    match /{col}/{id} {
      allow read: if col in ['photos','comics','settings'];
      allow write: if col in ['photos','comics','settings'] && isAdmin();
    }

    match /comments/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name','text','ts'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.text is string && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      allow delete: if isAdmin();
    }
    match /chat/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name','text','ts'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.text is string && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300;
      allow delete: if isAdmin();
    }
    match /likes/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['pid','vid','ts'])
        && request.resource.data.pid is string && request.resource.data.vid is string
        && id == request.resource.data.pid + '_' + request.resource.data.vid;
      allow delete: if true;
    }

    // Member rooms (signed-in members only)
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid && okUser(request.resource.data);
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    match /uphotos/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['owner','img','cap','ts'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.cap is string && request.resource.data.cap.size() <= 100
        && request.resource.data.img is string && request.resource.data.img.size() < 900000
        && request.resource.data.img.matches('data:image/jpeg;base64,.*');
      allow delete: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
    }

    // Private messages: only the two people involved can read them
    match /dms/{id} {
      allow read: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from','to','fromName','text','ts'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 40
        && request.resource.data.text is string && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      allow delete: if request.auth != null && resource.data.from == request.auth.uid;
    }

    // Stories: everyone reads, only the admin adds or changes (with their pictures and music)
    match /stories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /spics/{id} { allow read: if true; allow write: if isAdmin(); }
    match /stracks/{id} { allow read: if true; allow write: if isAdmin(); }
    match /schunks/{id} { allow read: if true; allow write: if isAdmin(); }

    // Member music (stored in small pieces)
    match /tracks/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['owner','title','mime','n','tid','ts'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 60
        && request.resource.data.mime is string && request.resource.data.mime.matches('^audio/.*')
        && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 6
        && request.resource.data.tid is string;
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    match /mchunks/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['owner','tid','i','n','d'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.d is string && request.resource.data.d.size() < 800000;
      allow delete: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
    }

    // 18+ section: only members the owner has approved can read
    match /adults/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
    match /nsfw/{id} {
      allow read: if request.auth != null
        && (isAdmin() || exists(/databases/$(database)/documents/adults/$(request.auth.uid)));
      allow write: if isAdmin();
    }

    // Voice room (members only): who is in the room, and the connection messages between two members
    match /vpeers/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','name','joinTs','ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.joinTs is number && request.resource.data.ts is number;
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    match /vsig/{id} {
      allow read: if request.auth != null && resource.data.to == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from','to','type','data','ts'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.type in ['offer','answer','cand']
        && request.resource.data.data is string && request.resource.data.data.size() < 20000;
      allow delete: if request.auth != null && resource.data.to == request.auth.uid;
    }

    // Voice room link: members only
    match /private/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
