rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can read everything and leave a comment (with limits)
    match /comments/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name','text','ts'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.text is string && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      allow delete: if request.auth != null && request.auth.token.email == 'david.d.rodriguez0804@gmail.com';
    }
    // Photos, comic pages and settings: only the admin can change them
    match /{col}/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'david.d.rodriguez0804@gmail.com';
    }
  }
}
