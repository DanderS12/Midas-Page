rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'david.d.rodriguez0804@gmail.com';
    }
    function memberAllowed() {
      return request.auth != null && (isAdmin() ||
        !exists(/databases/$(database)/documents/blockedEmails/$(request.auth.token.email.lower())));
    }
    function hex(c) {
      return c is string && c.matches('^#[0-9a-fA-F]{6}$');
    }
    function okUser(d, uid) {
      return d.keys().hasOnly(['uid','name','story','accent','bg','panel','text','border','btn','gc','pc','gs','ps','rh','cur','cc','tap','tc','css','song','songTitle','list','tag','about','mood','tags','links','av','top','ts'])
        && d.uid == uid
        && d.name is string && d.name.size() <= 40
        && d.story is string && d.story.size() <= 4000
        && hex(d.accent) && hex(d.bg) && hex(d.panel) && hex(d.text)
        && hex(d.border) && hex(d.btn) && (hex(d.gc) || d.gc == 'rainbow') && (hex(d.pc) || d.pc == 'rainbow')
        && d.gs in ['sparkle','dots','stars','hearts','flowers','snow','bubbles','fish','skulls','crystalskulls','crystals','bats','pumpkins','ghosts','autumn','leaf420','clover','fireworks','smiles','coins','rain','notes','petals','moons','suns','feathers','bolts','pixels','none']
        && d.ps in ['paws','hearts','stars','flowers','snow','bubbles','fish','skulls','crystalskulls','crystals','bats','pumpkins','ghosts','autumn','leaf420','clover','fireworks','smiles','coins','rain','notes','petals','moons','suns','feathers','bolts','pixels','none']
        && d.get('rh', '') in ['','rainbow','pride']
        && d.get('cur', '') is string && d.get('cur', '').size() <= 24
        && d.get('tap', '') is string && d.get('tap', '').size() <= 24
        && (hex(d.get('cc', '#ffd24a')) || d.get('cc', '#ffd24a') == 'rainbow')
        && (hex(d.get('tc', '#ffd24a')) || d.get('tc', '#ffd24a') == 'rainbow')
        && d.get('css', '') is string && d.get('css', '').size() <= 4000
        && d.song is string && d.song.size() <= 300
        && d.songTitle is string && d.songTitle.size() <= 60
        && d.get('list', []) is list && d.get('list', []).size() <= 6
        && d.get('tag', '') is string && d.get('tag', '').size() <= 80
        && d.get('about', '') is string && d.get('about', '').size() <= 1000
        && d.get('mood', '') is string && d.get('mood', '').size() <= 8
        && d.get('tags', []) is list && d.get('tags', []).size() <= 10
        && d.get('links', []) is list && d.get('links', []).size() <= 5
        && d.get('top', []) is list && d.get('top', []).size() <= 8
        && d.get('av', '') is string && d.get('av', '').size() < 20000;
    }

    // Main site content: everyone reads, only the admin changes
    match /{col}/{id} {
      allow read: if col in ['photos','comics','settings'];
      allow write: if col in ['photos','comics','settings'] && isAdmin();
    }

    match /comments/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name','text','ts'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.text is string && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      allow delete: if isAdmin();
    }
    match /chat/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name','text','ts'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.text is string && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300;
      allow delete: if isAdmin();
    }
    match /likes/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['pid','vid','ts'])
        && request.resource.data.pid is string && request.resource.data.vid is string
        && id == request.resource.data.pid + '_' + request.resource.data.vid;
      allow delete: if true;
    }

    // Member rooms (signed-in members only)
    match /users/{uid} {
      allow read: if memberAllowed();
      allow create: if memberAllowed() && (request.auth.uid == uid || isAdmin())
        && okUser(request.resource.data, uid);
      allow update: if memberAllowed() && request.auth.uid == uid
        && okUser(request.resource.data, uid);
      // Preserve an exact copy atomically before removing a room.
      allow delete: if isAdmin()
        && getAfter(/databases/$(database)/documents/roomArchive/$(uid)).data.room == resource.data;
    }
    match /roomArchive/{uid} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['room','deletedAt'])
        && request.resource.data.room == get(/databases/$(database)/documents/users/$(uid)).data
        && request.resource.data.deletedAt == request.time;
    }
    match /uphotos/{id} {
      allow read: if memberAllowed();
      allow create: if memberAllowed()
        && request.resource.data.keys().hasOnly(['owner','img','cap','ts'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.cap is string && request.resource.data.cap.size() <= 100
        && request.resource.data.img is string && request.resource.data.img.size() < 900000
        && request.resource.data.img.matches('data:image/jpeg;base64,.*');
      allow delete: if memberAllowed() && (resource.data.owner == request.auth.uid || isAdmin());
    }

    // Private messages: only the two people involved can read them
    match /dms/{id} {
      allow read: if memberAllowed()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if memberAllowed()
        && request.resource.data.keys().hasOnly(['from','to','fromName','text','ts','image','imageName'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to.size() > 0
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 40
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && request.resource.data.ts is number
        && (request.resource.data.text.size() > 0 || request.resource.data.get('image', '') != '')
        && request.resource.data.get('image', '') is string
        && request.resource.data.get('image', '').size() < 900000
        && (request.resource.data.get('image', '') == '' || request.resource.data.image.matches('data:image/jpeg;base64,.*'))
        && request.resource.data.get('imageName', '') is string
        && request.resource.data.get('imageName', '').size() <= 120;
      allow delete: if memberAllowed() && resource.data.from == request.auth.uid;
    }

    // Stories: everyone reads, only the admin adds or changes (with their pictures and music)
    match /stories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /spics/{id} { allow read: if true; allow write: if isAdmin(); }
    match /stracks/{id} { allow read: if true; allow write: if isAdmin(); }
    match /schunks/{id} { allow read: if true; allow write: if isAdmin(); }

    // Member music (stored in small pieces)
    match /tracks/{uid} {
      allow read: if memberAllowed();
      allow create, update: if memberAllowed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['owner','title','mime','n','tid','ts'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 60
        && request.resource.data.mime is string && request.resource.data.mime.matches('^audio/.*')
        && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 6
        && request.resource.data.tid is string;
      allow delete: if memberAllowed() && (request.auth.uid == uid || isAdmin());
    }
    match /mchunks/{id} {
      allow read: if memberAllowed();
      allow create: if memberAllowed()
        && request.resource.data.keys().hasOnly(['owner','tid','i','n','d'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.d is string && request.resource.data.d.size() < 800000;
      allow delete: if memberAllowed() && (resource.data.owner == request.auth.uid || isAdmin());
    }

    // 18+ section: only members the owner has approved can read
    match /adults/{uid} {
      allow read: if memberAllowed() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
    match /nsfw/{id} {
      allow read: if memberAllowed()
        && (isAdmin() || exists(/databases/$(database)/documents/adults/$(request.auth.uid)));
      allow write: if isAdmin();
    }

    // Public creator pages; ownership and kind can only be assigned by the admin.
    match /sponsors/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (memberAllowed() && resource.data.kind == 'creator'
        && resource.data.get('owner', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','blurb','link','img'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.blurb is string && request.resource.data.blurb.size() <= 4000
        && request.resource.data.link is string && request.resource.data.link.size() <= 300
        && (request.resource.data.link == '' || request.resource.data.link.matches('https://.*'))
        && request.resource.data.img is string && request.resource.data.img.size() < 900000
        && (request.resource.data.img == '' || request.resource.data.img.matches('data:image/jpeg;base64,.*')));
    }
    match /siteRoles/{uid} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['role'])
        && request.resource.data.role in ['admin','creator','sponsor'];
      allow delete: if isAdmin();
    }
    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Only a member's own token email can populate the private directory.
    match /memberDirectory/{uid} {
      allow read: if isAdmin();
      allow create, update: if memberAllowed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','email'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email.lower();
    }
    // A website-observed session log, not a mandatory sign-in audit.
    match /loginHistory/{id} {
      allow get: if isAdmin() || (memberAllowed()
        && id == request.auth.uid + '_' + string(request.auth.token.auth_time));
      allow list: if isAdmin();
      allow create: if memberAllowed()
        && request.resource.data.keys().hasOnly(['uid','email','authTime','ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.authTime == request.auth.token.auth_time
        && id == request.auth.uid + '_' + string(request.auth.token.auth_time)
        && request.resource.data.ts == request.time;
    }
    match /blockedEmails/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && id != request.auth.token.email.lower()
        && request.resource.data.keys().hasOnly(['value','ts'])
        && request.resource.data.value == id && request.resource.data.ts is number;
      allow delete: if isAdmin();
    }

    // Online status
    match /presence/{uid} {
      allow read: if memberAllowed();
      allow create, update: if memberAllowed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','st','ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.st in ['online','away','dnd','invisible']
        && request.resource.data.ts is number;
      allow delete: if memberAllowed() && request.auth.uid == uid;
    }

    // Followers
    match /follows/{id} {
      allow read: if memberAllowed();
      allow create: if memberAllowed()
        && request.resource.data.keys().hasOnly(['from','to','ts'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && id == request.resource.data.from + '_' + request.resource.data.to;
      allow delete: if memberAllowed() && resource.data.from == request.auth.uid;
    }

    // Friends (a request the other person accepts)
    match /friends/{id} {
      allow read: if memberAllowed() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if memberAllowed()
        && request.resource.data.keys().hasOnly(['from','to','status','ts'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'pending'
        && id == request.resource.data.from + '_' + request.resource.data.to;
      allow update: if memberAllowed() && resource.data.to == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if memberAllowed() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Alerts
    match /notifs/{id} {
      allow read: if memberAllowed() && resource.data.to == request.auth.uid;
      allow create: if memberAllowed()
        && request.resource.data.keys().hasOnly(['to','from','fromName','type','text','ts','read'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 40
        && request.resource.data.type in ['dm','follow','friend_request','friend_accept','wall']
        && request.resource.data.text is string && request.resource.data.text.size() <= 120
        && request.resource.data.read == false;
      allow update: if memberAllowed() && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if memberAllowed() && resource.data.to == request.auth.uid;
    }

    // Wall posts on a member's room
    match /wall/{id} {
      allow read: if memberAllowed();
      allow create: if memberAllowed()
        && request.resource.data.keys().hasOnly(['to','from','fromName','text','ts'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 40
        && request.resource.data.text is string && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300;
      allow delete: if memberAllowed() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid || isAdmin());
    }

    // Room cover banner
    match /uimg/{uid} {
      allow read: if memberAllowed();
      allow create, update: if memberAllowed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['banner'])
        && request.resource.data.banner is string && request.resource.data.banner.size() < 300000
        && request.resource.data.banner.matches('data:image/jpeg;base64,.*');
      allow delete: if memberAllowed() && (request.auth.uid == uid || isAdmin());
    }

    // Corner picture library: everyone reads, only the admin changes
    match /cpics/{id} { allow read: if true; allow write: if isAdmin(); }

    // Room background picture
    match /ubg/{uid} {
      allow read: if memberAllowed();
      allow create, update: if memberAllowed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['img'])
        && request.resource.data.img is string && request.resource.data.img.size() < 300000
        && request.resource.data.img.matches('data:image/jpeg;base64,.*');
      allow delete: if memberAllowed() && (request.auth.uid == uid || isAdmin());
    }

    // Voice room (members only): who is in the room, and the connection messages between two members
    match /vpeers/{uid} {
      allow read: if memberAllowed();
      allow create, update: if memberAllowed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','name','joinTs','ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.joinTs is number && request.resource.data.ts is number;
      allow delete: if memberAllowed() && (request.auth.uid == uid || isAdmin());
    }
    match /vsig/{id} {
      allow read: if memberAllowed() && resource.data.to == request.auth.uid;
      allow create: if memberAllowed()
        && request.resource.data.keys().hasOnly(['from','to','type','data','ts'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.type in ['offer','answer','cand']
        && request.resource.data.data is string && request.resource.data.data.size() < 20000;
      allow delete: if memberAllowed() && resource.data.to == request.auth.uid;
    }

    // Voice room link: members only
    match /private/{id} {
      allow read: if memberAllowed();
      allow write: if isAdmin();
    }
  }
}
